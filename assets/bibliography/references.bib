@article{Grallert2021GG,
  title = {Catch {{Me If You Can}}! {{Approaching}} the {{Arabic Press}} of the {{Late Ottoman Eastern Mediterranean}} through {{Digital History}}},
  shorttitle = {Catch Me If You Can!},
  author = {Grallert, Till},
